{
  "name": "a-deafening-noise",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-local.mjs",
    "setup:auth": "node scripts/setup-local.mjs --auth",
    "staging:sync": "node scripts/sync-production-to-staging.mjs",
    "codex": "npx --yes @openai/codex",
    "codex:login": "npx --yes @openai/codex login",
    "import:spotify": "node scripts/import-spotify-history.mjs",
    "spotify:sync": "node scripts/sync-spotify-accounts.mjs",
    "emails:build": "node scripts/build-auth-email-templates.mjs",
    "emails:check": "node scripts/build-auth-email-templates.mjs --check",
    "suggestions:refresh": "node scripts/refresh-concert-suggestions.mjs",
    "dev": "vite --host 127.0.0.1",
    "dev:network": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:unit": "node --test tests/*.test.mjs",
    "audit:security": "node scripts/audit-supabase-security.mjs",
    "db:backup": "node scripts/backup-supabase.mjs",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --config=playwright.a11y.config.js",
    "test:visual": "playwright test --config=playwright.visual.config.js",
    "test:visual:update": "playwright test --config=playwright.visual.config.js --update-snapshots",
    "test:lighthouse": "node scripts/run-lighthouse.mjs",
    "test:quality": "npm run test:e2e && npm run test:a11y && npm run test:visual && npm run test:lighthouse"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@sentry/react": "^10.73.0",
    "@supabase/supabase-js": "^2.110.8",
    "@vitejs/plugin-react": "^6.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-simple-maps": "^3.0.0",
    "vite": "^8.0.13",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "autoprefixer": "10.4.20",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.4.1",
    "postcss": "^8.5.23",
    "supabase": "^2.109.1",
    "tailwindcss": "3.4.17"
  },
  "overrides": {
    "d3-color": "^3.1.0",
    "nanoid": "^3.3.18"
  }
}
