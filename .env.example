# Copy this file to .env.local. Never commit real secrets.
VITE_SUPABASE_URL=https://your-development-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace_with_your_supabase_publishable_key
VITE_SPOTIFY_CLIENT_ID=replace_with_your_spotify_client_id

# Optional client-side error reporting. Leave empty to disable it.
VITE_SENTRY_DSN=

# Only needed when testing setlist.fm lookups locally.
SETLIST_API_KEY=replace_with_your_setlist_fm_api_key
TICKETMASTER_API_KEY=replace_with_your_ticketmaster_discovery_api_key
